# =============================================================================
# legadoholding.com — cabeceras de seguridad y endurecimiento (Apache / cPanel)
# Lo copia .cpanel.yml a public_html en cada deploy. La redirección a HTTPS
# la hace Cloudflare (no Apache), así que este archivo no la necesita.
# =============================================================================

# Sin listado de carpetas ("Index of /images").
Options -Indexes

# Nunca servir archivos internos si alguna vez llegan al servidor.
<FilesMatch "(^\.|\.(sql|md|yml|yaml|toml|docx|log|bak)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Solo HTTPS durante 1 año en este dominio (sin includeSubDomains ni preload
    # a propósito: no compromete otros subdominios).
    Header always set Strict-Transport-Security "max-age=31536000"

    # Nadie puede incrustar el sitio en un iframe ajeno (clickjacking del wizard).
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # CSP aplicada: solo directivas que no pueden romper el sitio.
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"

    # CSP completa en modo observación (Report-Only): NO bloquea nada, solo
    # avisa en la consola del navegador lo que bloquearía. Revisar la consola
    # unos días (incluye Google Tag Manager) y, si no hay avisos legítimos,
    # pasarla a Content-Security-Policy.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.legadoholding.com https://app.previsionfuneraria.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
